NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# info: the story of every scan and request. debug: also every check and every request to the scanned site. trace: also every event of a scan.
LOG_LEVEL=info
# Put the caller's address in the access, scan and stream logs. Off: an address is personal data (say so in the privacy policy when this is on).
LOG_CLIENT_IP=false

# Comma-separated origins allowed to call the API from a browser. Unset: http://localhost:3000; production must set it.
CORS_ORIGINS=http://localhost:3000

APP_VERSION=dev

# Heartbeat comment on every SSE stream (milliseconds).
SSE_HEARTBEAT_MS=15000
# Event streams one address may hold open at once (more answer 429).
SSE_MAX_STREAMS_PER_IP=10
# Event streams this process holds open at once, from everyone (more answer 503 with Retry-After).
MAX_OPEN_STREAMS=500

# Pause before each check (milliseconds) so a scan can be watched in development. 0 in production.
SCAN_STEP_DELAY_MS=700

# Fetching a scanned site: whole-fetch timeout (ms), bytes read from the response, redirects followed.
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=1048576
FETCH_MAX_REDIRECTS=5

# Rate limiting of POST /v1/scans: scans per window per address and per domain, and the window (ms).
SCAN_LIMIT_PER_IP=20
SCAN_LIMIT_PER_DOMAIN=10
SCAN_LIMIT_WINDOW_MS=3600000
# The same address scanned this recently (ms) gets that scan back instead of a new one; 0 turns it off. "Scan again" asks for a fresh one.
SCAN_REUSE_MS=600000
# The whole scan (ms): one still running after this long is stopped and reported as a timeout. A scan with no event for a minute
# longer whose job is gone (a lost Redis, a worker killed for good) is failed by the reaper.
SCAN_DEADLINE_MS=120000
# Scans run at once (the rest wait in the queue).
SCAN_MAX_CONCURRENT=8
# How long a report is kept before it is deleted with its log (ms): 30 days. The list of scanned domains is kept for good.
SCAN_RETENTION_MS=2592000000
# In memory only (no DATABASE_URL): how many scans are kept at most.
SCAN_MAX_STORED=1000

# Redis: the job queue and the wake-up channel for live scans (docker compose up -d). With it the API only queues a scan and a worker
# (`pnpm --filter @sitehp.app/backend build`, then `... start:worker`) runs it; it needs DATABASE_URL too. Without it the API runs scans itself.
# Production requires it.
# The compose Redis has a password (REDIS_PASSWORD, default sitehp): it goes in the URL.
# REDIS_URL=redis://:sitehp@localhost:6379
# The worker writes the time here at start and every 15 s; it is healthy while the file is under 60 s old.
# WORKER_HEARTBEAT_FILE=/tmp/sitehp-worker-heartbeat

# PostgreSQL (docker compose up -d). Without it scans live in memory and are lost on restart; production requires it.
# The compose password is POSTGRES_PASSWORD, default sitehp.
# DATABASE_URL=postgres://sitehp:sitehp@localhost:5433/sitehp

# No scan is made of these, and a redirect to them is not followed. Top-level domains (ASCII/punycode form) and single domains, comma-separated.
# Default: Russia (.ru .su .рф), Iran (.ir .ایران), China (.cn .中国 .中國). An empty BLOCKED_TLDS turns the country block off.
# BLOCKED_TLDS=ru,su,xn--p1ai,ir,xn--mgba3a4f16a,cn,xn--fiqs8s,xn--fiqz9s
# BLOCKED_DOMAINS=
# Proxies of ours in front of the API (0 when none). Must match the real chain.
TRUSTED_PROXY_HOPS=0
# The address ranges those proxies connect from (comma-separated CIDRs). X-Forwarded-For is read only from a peer inside one;
# empty trusts no peer. Required when TRUSTED_PROXY_HOPS is above 0.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8
# NAT64 prefixes of the scanner's network beyond the well-known 64:ff9b::/96 (comma-separated IPv6 /96s).
# NAT64_PREFIXES=

# Tests and demos only: answer scans from the demo sites in this folder (one subfolder with a site.json each) instead of the network.
# Refused in production. `pnpm dev:demo` sets it to demo-sites (see README, "Demo sites").
# SITE_FETCHER_REPLAY_DIR=demo-sites

