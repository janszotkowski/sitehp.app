{
    "name": "@sitehp.app/backend",
    "version": "0.0.0",
    "private": true,
    "description": "Backend: HTTP API (Hono), later workers and scheduler",
    "type": "module",
    "scripts": {
        "dev": "tsdown --watch --on-success \"node --env-file-if-exists=.env dist/main.api.mjs\"",
        "dev:demo": "SITE_FETCHER_REPLAY_DIR=demo-sites tsdown --watch --on-success \"node --env-file-if-exists=.env dist/main.api.mjs\"",
        "build": "tsdown",
        "start": "node --env-file-if-exists=.env dist/main.api.mjs",
        "start:worker": "node --env-file-if-exists=.env dist/main.worker.mjs",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json",
        "db:generate": "drizzle-kit generate",
        "sites": "tsdown && node --env-file-if-exists=.env dist/main.sites.mjs"
    },
    "dependencies": {
        "@hono/node-server": "2.1.3",
        "@hono/zod-validator": "0.9.1",
        "@sitehp.app/core": "workspace:*",
        "bullmq": "6.3.11",
        "drizzle-orm": "0.45.3",
        "hono": "4.13.12",
        "ioredis": "6.0.0",
        "pino": "10.4.0",
        "postgres": "3.4.9",
        "tldts": "7.4.16",
        "undici": "8.11.2",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@electric-sql/pglite": "0.5.8",
        "@types/node": "26.6.4",
        "drizzle-kit": "0.31.11",
        "tsdown": "0.23.0",
        "vitest": "5.0.3"
    }
}
