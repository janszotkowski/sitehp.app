# Canonical origin used in canonical URLs, Open Graph and the sitemap. Production uses https://sitehp.app
# (the default when unset); a build for that origin fails unless VITE_ALLOW_INDEXING=true.
VITE_SITE_URL=http://localhost:3000

# Set to true ONLY in production. Anywhere else every page is noindex and every response carries X-Robots-Tag: noindex.
VITE_ALLOW_INDEXING=false

# The pages say the product is in beta (a green Beta pill by the logo, above the landing page's title and, on a phone, floating in the corner, plus a line in the footer). On unless set to false:
# turn it off for the real launch. Baked into the bundle at build time.
VITE_SHOW_BETA=true

# Origin of the backend API as the BROWSER calls it. Required for every build (it is baked into the bundle);
# the frontend's own origin must be in the backend's CORS_ORIGINS.
VITE_API_URL=http://localhost:4000

# Origin of the backend as the frontend SERVER calls it during SSR (optional; defaults to VITE_API_URL).
# Read at runtime on the server only, never bundled for the browser.
API_INTERNAL_URL=
